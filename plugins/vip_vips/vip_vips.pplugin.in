{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${VIP_VIPS_VERSION}",
	"name": "vip_vips",
	"description": "[VIP] VIPS: !vips (and mm_vips / sm_vips / vips) lists every VIP that is on the server, with or without the VIP group in parentheses depending on vip_vips.ini. Ported from the Pisex VIP core module VIP_Vips (vip_vips). Requires the vip core.",
	"author": "Pisex, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/vip_vips",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "vip",
			"constraints": ">=1.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	]
}
